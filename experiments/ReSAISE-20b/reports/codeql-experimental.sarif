{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"CodeQL","organization":"GitHub","semanticVersion":"2.25.4","notifications":[{"id":"py/baseline/expected-extracted-files","name":"py/baseline/expected-extracted-files","shortDescription":{"text":"Expected extracted files"},"fullDescription":{"text":"Files appearing in the source archive that are expected to be extracted."},"defaultConfiguration":{"enabled":true},"properties":{"tags":["expected-extracted-files","telemetry"]}},{"id":"cli/file-coverage-baseline","name":"cli/file-coverage-baseline","shortDescription":{"text":"File coverage baseline telemetry"},"fullDescription":{"text":"File coverage baseline telemetry"},"defaultConfiguration":{"enabled":true}},{"id":"cli/platform","name":"cli/platform","shortDescription":{"text":"Platform"},"fullDescription":{"text":"Platform"},"defaultConfiguration":{"enabled":true}},{"id":"cli/sip-enablement","name":"cli/sip-enablement","shortDescription":{"text":"macOS SIP enablement status"},"fullDescription":{"text":"macOS SIP enablement status"},"defaultConfiguration":{"enabled":true}},{"id":"py/diagnostics/syntax-error","name":"py/diagnostics/syntax-error","shortDescription":{"text":"Could not process some files due to syntax errors"},"fullDescription":{"text":"Could not process some files due to syntax errors"},"defaultConfiguration":{"enabled":true}}],"rules":[{"id":"py/timing-attack-against-hash","name":"py/timing-attack-against-hash","shortDescription":{"text":"Timing attack against Hash"},"fullDescription":{"text":"When checking a Hash over a message, a constant-time algorithm should be used. Otherwise, an attacker may be able to forge a valid Hash for an arbitrary message by running a timing attack if they can send to the validation procedure. A successful attack can result in authentication bypass."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-208"],"description":"When checking a Hash over a message, a constant-time algorithm should be used.\n              Otherwise, an attacker may be able to forge a valid Hash for an arbitrary message\n              by running a timing attack if they can send to the validation procedure.\n              A successful attack can result in authentication bypass.","id":"py/timing-attack-against-hash","kind":"path-problem","name":"Timing attack against Hash","precision":"low","problem.severity":"error"}},{"id":"py/possible-timing-attack-against-hash","name":"py/possible-timing-attack-against-hash","shortDescription":{"text":"Timing attack against Hash"},"fullDescription":{"text":"When checking a Hash over a message, a constant-time algorithm should be used. Otherwise, an attacker may be able to forge a valid Hash for an arbitrary message by running a timing attack if they can send to the validation procedure. A successful attack can result in authentication bypass."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-208","experimental"],"description":"When checking a Hash over a message, a constant-time algorithm should be used.\n              Otherwise, an attacker may be able to forge a valid Hash for an arbitrary message\n              by running a timing attack if they can send to the validation procedure.\n              A successful attack can result in authentication bypass.","id":"py/possible-timing-attack-against-hash","kind":"path-problem","name":"Timing attack against Hash","precision":"low","problem.severity":"error"}},{"id":"py/timing-attack-sensitive-info","name":"py/timing-attack-sensitive-info","shortDescription":{"text":"Timing attack against secret"},"fullDescription":{"text":"Use of a non-constant-time verification routine to check the value of an secret, possibly allowing a timing attack to retrieve sensitive information."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-208","experimental"],"description":"Use of a non-constant-time verification routine to check the value of an secret,\n              possibly allowing a timing attack to retrieve sensitive information.","id":"py/timing-attack-sensitive-info","kind":"path-problem","name":"Timing attack against secret","precision":"low","problem.severity":"error"}},{"id":"py/possible-timing-attack-sensitive-info","name":"py/possible-timing-attack-sensitive-info","shortDescription":{"text":"Timing attack against secret"},"fullDescription":{"text":"Use of a non-constant-time verification routine to check the value of an secret, possibly allowing a timing attack to retrieve sensitive information."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-208","experimental"],"description":"Use of a non-constant-time verification routine to check the value of an secret,\n              possibly allowing a timing attack to retrieve sensitive information.","id":"py/possible-timing-attack-sensitive-info","kind":"path-problem","name":"Timing attack against secret","precision":"low","problem.severity":"error"}},{"id":"py/timing-attack-against-header-value","name":"py/timing-attack-against-header-value","shortDescription":{"text":"Timing attack against header value"},"fullDescription":{"text":"Use of a non-constant-time verification routine to check the value of an HTTP header, possibly allowing a timing attack to infer the header's expected value."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-208","experimental"],"description":"Use of a non-constant-time verification routine to check the value of an HTTP header,\n              possibly allowing a timing attack to infer the header's expected value.","id":"py/timing-attack-against-header-value","kind":"path-problem","name":"Timing attack against header value","precision":"high","problem.severity":"error"}},{"id":"py/js2py-rce","name":"py/js2py-rce","shortDescription":{"text":"JavaScript code execution"},"fullDescription":{"text":"Passing user supplied arguments to a Javascript to Python translation engine such as Js2Py can lead to remote code execution."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-094"],"description":"Passing user supplied arguments to a Javascript to Python translation engine such as Js2Py can lead to remote code execution.","id":"py/js2py-rce","kind":"path-problem","name":"JavaScript code execution","precision":"high","problem.severity":"error","security-severity":"9.3"}},{"id":"py/unicode-bypass-validation","name":"py/unicode-bypass-validation","shortDescription":{"text":"Bypass Logical Validation Using Unicode Characters"},"fullDescription":{"text":"A Unicode transformation is using a remote user-controlled data. The transformation is a Unicode normalization using the algorithms \"NFC\" or \"NFKC\". In all cases, the security measures implemented or the logical validation performed to escape any injection characters, to validate using regex patterns or to perform string-based checks, before the Unicode transformation are **bypassable** by special Unicode characters."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-176","external/cwe/cwe-179","external/cwe/cwe-180"],"description":"A Unicode transformation is using a remote user-controlled data. The transformation is a Unicode normalization using the algorithms \"NFC\" or \"NFKC\". In all cases, the security measures implemented or the logical validation performed to escape any injection characters, to validate using regex patterns or to perform string-based checks, before the Unicode transformation are **bypassable** by special Unicode characters.","id":"py/unicode-bypass-validation","kind":"path-problem","name":"Bypass Logical Validation Using Unicode Characters","precision":"high","problem.severity":"error"}},{"id":"py/azure-storage/unsafe-client-side-encryption-in-use","name":"py/azure-storage/unsafe-client-side-encryption-in-use","shortDescription":{"text":"Unsafe usage of v1 version of Azure Storage client-side encryption"},"fullDescription":{"text":"Using version v1 of Azure Storage client-side encryption is insecure, and may enable an attacker to decrypt encrypted data"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","cryptography","external/cwe/cwe-327"],"description":"Using version v1 of Azure Storage client-side encryption is insecure, and may enable an attacker to decrypt encrypted data","id":"py/azure-storage/unsafe-client-side-encryption-in-use","kind":"path-problem","name":"Unsafe usage of v1 version of Azure Storage client-side encryption","precision":"medium","problem.severity":"error"}},{"id":"py/cors-misconfiguration-with-credentials","name":"py/cors-misconfiguration-with-credentials","shortDescription":{"text":"Cors misconfiguration with credentials"},"fullDescription":{"text":"Disabling or weakening SOP protection may make the application vulnerable to a CORS attack."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental","external/cwe/cwe-942"],"description":"Disabling or weakening SOP protection may make the application\n              vulnerable to a CORS attack.","id":"py/cors-misconfiguration-with-credentials","kind":"problem","name":"Cors misconfiguration with credentials","precision":"high","problem.severity":"warning","security-severity":"8.8"}},{"id":"py/insecure-ldap-auth","name":"py/insecure-ldap-auth","shortDescription":{"text":"Python Insecure LDAP Authentication"},"fullDescription":{"text":"Python LDAP Insecure LDAP Authentication"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-522","external/cwe/cwe-523"],"description":"Python LDAP Insecure LDAP Authentication","id":"py/insecure-ldap-auth","kind":"path-problem","name":"Python Insecure LDAP Authentication","problem.severity":"error"}},{"id":"py/unsafe-unpacking","name":"py/unsafe-unpacking","shortDescription":{"text":"Arbitrary file write during a tarball extraction from a user controlled source"},"fullDescription":{"text":"Extracting files from a potentially malicious tarball using `shutil.unpack_archive()` without validating that the destination file path is within the destination directory can cause files outside the destination directory to be overwritten. More precisely, if the tarball comes from a user controlled location either a remote one or cli argument."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-022"],"description":"Extracting files from a potentially malicious tarball using `shutil.unpack_archive()` without validating\n              that the destination file path is within the destination directory can cause files outside\n              the destination directory to be overwritten. More precisely, if the tarball comes from a user controlled\n              location either a remote one or cli argument.","id":"py/unsafe-unpacking","kind":"path-problem","name":"Arbitrary file write during a tarball extraction from a user controlled source","precision":"medium","problem.severity":"error","security-severity":"7.5"}},{"id":"py/tarslip-extended","name":"py/tarslip-extended","shortDescription":{"text":"Arbitrary file write during tarfile extraction"},"fullDescription":{"text":"Extracting files from a malicious tar archive without validating that the destination file path is within the destination directory can cause files outside the destination directory to be overwritten."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-022"],"description":"Extracting files from a malicious tar archive without validating that the\n              destination file path is within the destination directory can cause files outside\n              the destination directory to be overwritten.","id":"py/tarslip-extended","kind":"path-problem","name":"Arbitrary file write during tarfile extraction","precision":"high","problem.severity":"error","security-severity":"7.5"}},{"id":"py/paramiko-command-injection","name":"py/paramiko-command-injection","shortDescription":{"text":"Command execution on a secondary remote server"},"fullDescription":{"text":"user provided command can lead to execute code on a external server that can be belong to other users or admins"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-074"],"description":"user provided command can lead to execute code on a external server that can be belong to other users or admins","id":"py/paramiko-command-injection","kind":"path-problem","name":"Command execution on a secondary remote server","precision":"high","problem.severity":"error","security-severity":"9.3"}},{"id":"py/decompression-bomb","name":"py/decompression-bomb","shortDescription":{"text":"Decompression Bomb"},"fullDescription":{"text":"Uncontrolled data that flows into decompression library APIs without checking the compression rate is dangerous"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-409"],"description":"Uncontrolled data that flows into decompression library APIs without checking the compression rate is dangerous","id":"py/decompression-bomb","kind":"path-problem","name":"Decompression Bomb","precision":"high","problem.severity":"error","security-severity":"7.8"}},{"id":"py/xslt-injection","name":"py/xslt-injection","shortDescription":{"text":"XSLT query built from user-controlled sources"},"fullDescription":{"text":"Building a XSLT query from user-controlled sources is vulnerable to insertion of malicious XSLT code by the user."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-643"],"description":"Building a XSLT query from user-controlled sources is vulnerable to insertion of\n              malicious XSLT code by the user.","id":"py/xslt-injection","kind":"path-problem","name":"XSLT query built from user-controlled sources","precision":"high","problem.severity":"error"}},{"id":"py/prompt-injection","name":"py/prompt-injection","shortDescription":{"text":"Prompt injection"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-1427"],"id":"py/prompt-injection","kind":"path-problem","name":"Prompt injection","precision":"high","problem.severity":"error","security-severity":"5.0"}},{"id":"py/flask-constant-secret-key","name":"py/flask-constant-secret-key","shortDescription":{"text":"Initializing SECRET_KEY of Flask application with Constant value"},"fullDescription":{"text":"Initializing SECRET_KEY of Flask application with Constant value files can lead to Authentication bypass"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-287"],"description":"Initializing SECRET_KEY of Flask application with Constant value\n files can lead to Authentication bypass","id":"py/flask-constant-secret-key","kind":"path-problem","name":"Initializing SECRET_KEY of Flask application with Constant value","precision":"high","problem.severity":"error","security-severity":"8.5"}},{"id":"py/predictable-token","name":"py/predictable-token","shortDescription":{"text":"Predictable token"},"fullDescription":{"text":"Tokens used for sensitive tasks, such as, password recovery, and email confirmation, should not use predictable values."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-340"],"description":"Tokens used for sensitive tasks, such as, password recovery,\n  and email confirmation, should not use predictable values.","id":"py/predictable-token","kind":"path-problem","name":"Predictable token","precision":"medium","problem.severity":"error","security-severity":"5"}},{"id":"py/jwt-empty-secret-or-algorithm","name":"py/jwt-empty-secret-or-algorithm","shortDescription":{"text":"JWT encoding using empty key or algorithm"},"fullDescription":{"text":"The application uses an empty secret or algorithm while encoding a JWT Token."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental"],"description":"The application uses an empty secret or algorithm while encoding a JWT Token.","id":"py/jwt-empty-secret-or-algorithm","kind":"problem","name":"JWT encoding using empty key or algorithm","problem.severity":"warning"}},{"id":"py/jwt-missing-verification","name":"py/jwt-missing-verification","shortDescription":{"text":"JWT missing secret or public key verification"},"fullDescription":{"text":"The application does not verify the JWT payload with a cryptographic secret or public key."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental","external/cwe/cwe-347"],"description":"The application does not verify the JWT payload with a cryptographic secret or public key.","id":"py/jwt-missing-verification","kind":"problem","name":"JWT missing secret or public key verification","problem.severity":"warning"}},{"id":"py/unicode-dos","name":"py/unicode-dos","shortDescription":{"text":"Denial of Service using Unicode Characters"},"fullDescription":{"text":"A remote user-controlled data can reach a costly Unicode normalization with either form NFKC or NFKD. On Windows OS, with an attack such as the One Million Unicode Characters, this could lead to a denial of service. And, with the use of special Unicode characters, like U+2100 (℀) or U+2105 (℅), the payload size could be tripled."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-770"],"description":"A remote user-controlled data can reach a costly Unicode normalization with either form NFKC or NFKD. On Windows OS, with an attack such as the One Million Unicode Characters, this could lead to a denial of service. And, with the use of special Unicode characters, like U+2100 (℀) or U+2105 (℅), the payload size could be tripled.","id":"py/unicode-dos","kind":"path-problem","name":"Denial of Service using Unicode Characters","precision":"high","problem.severity":"error"}},{"id":"py/cors-bypass","name":"py/cors-bypass","shortDescription":{"text":"Cross Origin Resource Sharing(CORS) Policy Bypass"},"fullDescription":{"text":"Checking user supplied origin headers using weak comparators like 'string.startswith' may lead to CORS policy bypass."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","externa/cwe/CWE-346"],"description":"Checking user supplied origin headers using weak comparators like 'string.startswith' may lead to CORS policy bypass.","id":"py/cors-bypass","kind":"path-problem","name":"Cross Origin Resource Sharing(CORS) Policy Bypass","problem.severity":"warning"}},{"id":"py/ip-address-spoofing","name":"py/ip-address-spoofing","shortDescription":{"text":"IP address spoofing"},"fullDescription":{"text":"A remote endpoint identifier is read from an HTTP header. Attackers can modify the value of the identifier to forge the client ip."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-348"],"description":"A remote endpoint identifier is read from an HTTP header. Attackers can modify the value\n              of the identifier to forge the client ip.","id":"py/ip-address-spoofing","kind":"path-problem","name":"IP address spoofing","precision":"high","problem.severity":"error"}},{"id":"py/insecure-randomness","name":"py/insecure-randomness","shortDescription":{"text":"Insecure randomness"},"fullDescription":{"text":"Using a cryptographically weak pseudo-random number generator to generate a security-sensitive value may allow an attacker to predict what value will be generated."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental","external/cwe/cwe-338"],"description":"Using a cryptographically weak pseudo-random number generator to generate a\n              security-sensitive value may allow an attacker to predict what value will\n              be generated.","id":"py/insecure-randomness","kind":"path-problem","name":"Insecure randomness","precision":"high","problem.severity":"warning","security-severity":"7.8"}},{"id":"py/csv-injection","name":"py/csv-injection","shortDescription":{"text":"Csv Injection"},"fullDescription":{"text":"From user-controlled data saved in CSV files, it is easy to attempt information disclosure or other malicious activities when automated by spreadsheet software"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-1236"],"description":"From user-controlled data saved in CSV files, it is easy to attempt information disclosure\n              or other malicious activities when automated by spreadsheet software","id":"py/csv-injection","kind":"path-problem","name":"Csv Injection","problem.severity":"error"}},{"id":"py/zipslip","name":"py/zipslip","shortDescription":{"text":"Arbitrary file access during archive extraction (\"Zip Slip\")"},"fullDescription":{"text":"Extracting files from a malicious ZIP file, or similar type of archive, without validating that the destination file path is within the destination directory can allow an attacker to unexpectedly gain access to resources."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-022"],"description":"Extracting files from a malicious ZIP file, or similar type of archive, without\n              validating that the destination file path is within the destination directory\n              can allow an attacker to unexpectedly gain access to resources.","id":"py/zipslip","kind":"path-problem","name":"Arbitrary file access during archive extraction (\"Zip Slip\")","precision":"high","problem.severity":"error","security-severity":"7.5"}},{"id":"py/simple-xml-rpc-server-dos","name":"py/simple-xml-rpc-server-dos","shortDescription":{"text":"SimpleXMLRPCServer denial of service"},"fullDescription":{"text":"SimpleXMLRPCServer is vulnerable to denial of service attacks from untrusted user input"},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental","external/cwe/cwe-776"],"description":"SimpleXMLRPCServer is vulnerable to denial of service attacks from untrusted user input","id":"py/simple-xml-rpc-server-dos","kind":"problem","name":"SimpleXMLRPCServer denial of service","precision":"high","problem.severity":"warning"}},{"id":"py/reflective-xss-email","name":"py/reflective-xss-email","shortDescription":{"text":"Reflected server-side cross-site scripting"},"fullDescription":{"text":"Writing user input directly to a web page allows for a cross-site scripting vulnerability."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","experimental","external/cwe/cwe-079","external/cwe/cwe-116"],"description":"Writing user input directly to a web page\n              allows for a cross-site scripting vulnerability.","id":"py/reflective-xss-email","kind":"path-problem","name":"Reflected server-side cross-site scripting","problem.severity":"error","security-severity":"2.9","sub-severity":"high"}},{"id":"py/improper-ldap-auth","name":"py/improper-ldap-auth","shortDescription":{"text":"Improper LDAP Authentication"},"fullDescription":{"text":"A user-controlled query car